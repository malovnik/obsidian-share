# Server Configuration
PORT=4000
NODE_ENV=development

# Database (автоматически устанавливается Railway при подключении PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/obsidian_share

# Frontend URL (для генерации ссылок на опубликованные заметки)
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# CORS (URL фронтенда, который может делать запросы к API)
CORS_ORIGIN=http://localhost:3000
