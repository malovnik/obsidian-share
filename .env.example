# Database URL (PostgreSQL)
# Локально: postgresql://localhost:5432/obsidian_share
# Railway: предоставляется автоматически через ${{postgres-volume.DATABASE_URL}}
DATABASE_URL=postgresql://localhost:5432/obsidian_share

# Base URL (для генерации публичных ссылок)
# Локально: http://localhost:3000
# Railway: https://ваш-домен.up.railway.app
# Кастомный домен: https://share.yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
